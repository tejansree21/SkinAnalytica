# SkinAnalytica — environment variables reference.
# Copy to .env for local dev (it's gitignored). Render sets these directly
# in render.yaml / the dashboard — this file is documentation, not loaded
# automatically by anything.

# Base path for models/data/outputs. Auto-detected if unset (see
# api/SA05_api.py _detect_base()) — only set this to override the
# auto-detection, e.g. for tests or an unusual deployment layout.
SKINANALYTICA_BASE=

# Which model(s) SA05_api.py's ModelRegistry loads: "full" (ensemble --
# int8, falling back to fp32, falling back to EfficientNet-alone; the
# deployed default, and the mode every threshold in SA05_api.py was
# calibrated against), "int8" (quantized ensemble only, same fallback to
# EfficientNet), "efficientnet" (single backbone only -- do not deploy
# with this: production thresholds are ensemble-calibrated and do not
# match EfficientNet-alone's score distribution, see docs/MODEL_CARD.md
# finding #10).
SKINANALYTICA_MODEL_MODE=full

# Loads all 3 individual backbone ONNX files (in addition to whatever
# SKINANALYTICA_MODEL_MODE already loads) to compute inter-model
# disagreement as an uncertainty signal on /analyze responses. Defaults to
# true in api/SA05_api.py as of finding #28 -- shipped over adding PyTorch
# to production, since neither approach caught the one real tested
# false-negative case, and this one is free and already built (see
# docs/MODEL_CARD.md finding #7 for the known blind spot). Real memory
# cost though: ~2.1GB of fp32 ONNX files loaded in addition to the primary
# model -- render.yaml explicitly pins this to "false" for the live
# skinanalytica-api service (Render free tier), overriding the code
# default, because that would almost certainly OOM-crash it. Leave this
# as the code default (true) for local dev; set explicitly per-deployment
# if the target environment can't afford the memory.
SKINANALYTICA_ENABLE_UNCERTAINTY=true

# CORS: additional allowed frontend origin beyond the hardcoded list in
# SA05_api.py's ALLOWED_ORIGINS.
SKINANALYTICA_FRONTEND_URL=

# Required for the assistant service (assistant/assistant_api.py) and any
# Claude-backed features. Set as a secret in Render's dashboard
# (render.yaml marks it `sync: false`) — never commit a real value here.
ANTHROPIC_API_KEY=

# Gates every patient-data endpoint (/analyze, /analyze/batch,
# /report/{id}, /report/{id}/fhir, /patient/{id}/history, /audit/log) --
# callers must send it as the `X-API-Key` header. Required, not optional:
# api/SA05_api.py's require_api_key() fails CLOSED (503) if this is unset,
# rather than silently running with no auth at all (see docs/MODEL_CARD.md
# -- this closed the top-priority item flagged across two independent
# audit passes). Set as a secret in Render's dashboard (render.yaml marks
# it `sync: false`) — never commit a real value here. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SKINANALYTICA_API_KEY=
