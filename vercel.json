{
  "version": 2,
  "name": "skinanalytica",
  "routes": [
    { "src": "/",             "dest": "/index.html" },
    { "src": "/docs",         "dest": "/docs.html" },
    { "src": "/status",       "dest": "/status.html" },
    { "src": "/assets/(.*)",  "dest": "/assets/$1" },
    { "src": "/(.*\\.html)",  "dest": "/$1" },
    { "src": "/(.*\\.js)",    "dest": "/$1" },
    { "src": "/(.*)",         "dest": "/index.html" }
  ]
}
